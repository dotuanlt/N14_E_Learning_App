# Sao chép file này thành ".env" (cùng thư mục với docker-compose.yml) rồi điền giá trị thật.
# KHÔNG đưa file .env lên GitHub công khai.

# ----- Database PostgreSQL (Neon) -----
DB_URL=jdbc:postgresql://<host-neon>/<ten-db>?sslmode=require
DB_USERNAME=
DB_PASSWORD=

# ----- JWT (tối thiểu 32 ký tự) -----
JWT_SECRET=doi-thanh-chuoi-bi-mat-dai-it-nhat-32-ky-tu

# ----- Địa chỉ backend mà thiết bị quét QR thanh toán truy cập được -----
# Chỉ dùng máy tính xem: để http://localhost:8080
# Muốn quét QR bằng điện thoại: dùng IP LAN của máy chạy Docker, ví dụ http://192.168.1.10:8080
PUBLIC_BASE_URL=http://localhost:8080

# ----- OTP demo: true = nhập 123456 là qua (giáo viên không cần email thật) -----
OTP_ALLOW_DEV_CODE=true

# ----- Email (Gmail SMTP, tùy chọn). Để trống MAIL_USERNAME = OTP chỉ ghi ra log backend -----
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ----- Trợ lý AI -----
# provider: gemini | openai (Groq) | mock (không cần khóa)
CHAT_PROVIDER=gemini
GEMINI_API_KEY=
# Dự phòng khi Gemini hết hạn mức: CHAT_FALLBACK_PROVIDER=openai
CHAT_FALLBACK_PROVIDER=
GROQ_API_KEY=

# ----- Thanh toán -----
PAYMENT_MOCK_ENABLED=true
